# ---- Required --------------------------------------------------------------
# Full external URL, including the sub-path if the app is not at the site root.
PUBLIC_URL=https://attendance.example.edu
# Random string, at least 32 characters:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Comma-separated. Admins can change settings and are always teachers.
ADMIN_EMAILS=admin@example.edu

# Port on the host for compose.yaml (the container listens on 8000).
HOST_PORT=8000

# ---- Initial settings (used only until changed on the Settings page) -------
INSTITUTION_NAME=
STUDENT_DOMAINS=students.example.edu
TEACHER_DOMAINS=
TEACHER_EMAILS=
TIMEZONE=UTC

# ---- Sign-in ---------------------------------------------------------------
# One-time email codes; needs SMTP below. Set to false to allow SSO only.
OTP_LOGIN=true

# Comma-separated list of OIDC providers: google, microsoft, or any name.
# Redirect URI to register with each provider: ${PUBLIC_URL}/auth/<name>
OIDC_PROVIDERS=
OIDC_GOOGLE_CLIENT_ID=
OIDC_GOOGLE_CLIENT_SECRET=
# OIDC_MICROSOFT_CLIENT_ID=
# OIDC_MICROSOFT_CLIENT_SECRET=
# OIDC_MICROSOFT_TENANT=organizations   # or your tenant id
# Any other OIDC provider (Keycloak, Okta, ...):
# OIDC_KEYCLOAK_CLIENT_ID=
# OIDC_KEYCLOAK_CLIENT_SECRET=
# OIDC_KEYCLOAK_METADATA_URL=https://sso.example.edu/realms/main/.well-known/openid-configuration
# OIDC_KEYCLOAK_LABEL=University SSO

# ---- Email (sign-in codes, student confirmations, teacher reports) ---------
# Leave SMTP_HOST empty to only log messages (development).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=attendance@example.edu
SMTP_STARTTLS=true
SMTP_SSL=false
